{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/course-detail.php",
      "has": [
        {
          "type": "query",
          "key": "course",
          "value": "(?<course>.*)"
        }
      ],
      "destination": "/course-detail?course=:course",
      "permanent": false
    },
    {
      "source": "/course-detail.php",
      "destination": "/course-detail",
      "permanent": false
    },
    {
      "source": "/about.php",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/director.php",
      "destination": "/director",
      "permanent": false
    },
    {
      "source": "/courses.php",
      "destination": "/courses",
      "permanent": false
    },
    {
      "source": "/faculty-facilities.php",
      "destination": "/faculty-facilities",
      "permanent": false
    },
    {
      "source": "/career-advisors.php",
      "destination": "/career-advisors",
      "permanent": false
    },
    {
      "source": "/college-activity.php",
      "destination": "/gallery",
      "permanent": false
    },
    {
      "source": "/gallery.php",
      "destination": "/gallery",
      "permanent": false
    },
    {
      "source": "/results.php",
      "destination": "/results",
      "permanent": false
    },
    {
      "source": "/blog.php",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/blog-single.php",
      "has": [
        {
          "type": "query",
          "key": "post",
          "value": "(?<post>.*)"
        }
      ],
      "destination": "/blog-single?post=:post",
      "permanent": false
    },
    {
      "source": "/blog-single.php",
      "destination": "/blog-single",
      "permanent": false
    },
    {
      "source": "/contact.php",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/online-registration-form.php",
      "destination": "/online-registration-form",
      "permanent": false
    },
    {
      "source": "/online-registration.php",
      "destination": "/online-registration-form",
      "permanent": false
    },
    {
      "source": "/online-registration",
      "destination": "/online-registration-form",
      "permanent": false
    },
    {
      "source": "/online-payment.php",
      "destination": "/online-payment",
      "permanent": false
    },
    {
      "source": "/privacy-policy.php",
      "destination": "/privacy-policy",
      "permanent": false
    },
    {
      "source": "/terms.php",
      "destination": "/terms",
      "permanent": false
    },
    {
      "source": "/404.php",
      "destination": "/404",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
